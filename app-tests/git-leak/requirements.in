# The scope bed runs with these, installed from requirements.txt with --require-hashes.
# requirements.txt is generated from this file, from the repository root, with:
#   uv pip compile --no-config --directory app-tests --python-version 3.14 --universal \
#     --generate-hashes git-leak/requirements.in --output-file git-leak/requirements.txt
# It runs in app-tests, where Dependabot compiles both of its locks, so that the file's "via"
# paths are the ones Dependabot writes. The pip-compile hook in .pre-commit-config.yaml runs that
# command and fails when the file changes.
GitPython==3.2.1
pytest==9.2.0
pytest-timeout==2.4.0
requests==2.34.2
