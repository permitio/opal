# The build context is the checkout (CI and the release use context: .); nothing copies .git
.git
venv/
documentation/
rego_clone/
.github/
docker/
Makefile
Dockerfile
.dockerignore
.gitignore
.pre-commit-config.yaml
# Test fixtures that hold certificates, such as the compromised eMudhra CAs the
# trust-store test uses. CI and the release build from the checkout, where this
# applies. BuildKit skips .dockerignore for a Git context (docker build <git-url>),
# so docker/Dockerfile excludes them with COPY --exclude as well.
packages/**/tests/*.pem
